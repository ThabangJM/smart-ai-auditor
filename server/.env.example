# Environment Variables for NST Solutions Backend

# Server Configuration
PORT=3000
NODE_ENV=development

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# CORS Configuration (Frontend URLs)
ALLOWED_ORIGINS=https://nstsolutions.co.za,http://nstsolutions.co.za,https://www.nstsolutions.co.za,http://www.nstsolutions.co.za

# Firebase Admin SDK (Optional - for Firebase integration)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=.pdf,.doc,.docx

# Logging
LOG_LEVEL=info
